.root {
    width: 100%;
    height: 100%;
    background-image: url("/Assets/Art/Gemini-Generated-bg.png");
    -unity-background-scale-mode: scale-and-crop;
    align-items: center;
}

.logo {
    margin-top: 100px;
    width: 700px;
    height: 252px;
    background-image: url("/Assets/Art/Gemini_Generated_logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

.play-button {
    width: 500px;
    height: 160px;
    margin-top: auto;
    margin-bottom: 160px;
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    background-color: rgb(51, 166, 89);
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-right-width: 0;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
}

.play-button:hover {
    background-color: rgb(61, 186, 102);
}

.play-button:active {
    background-color: rgb(41, 140, 75);
}
